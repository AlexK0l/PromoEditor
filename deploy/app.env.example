# Copy to deploy/app.env on the VPS; chmod 600. Never commit the real app.env.
# Leave blank for the safe offline/demo mode until paid OpenAI access is configured.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
PROMO_REQUESTS_PER_HOUR=10
PROMO_JOB_TTL_SECONDS=7200
# Isolated resource-bounded parsing of untrusted documents.
PROMO_DOCUMENT_TIMEOUT_SECONDS=15
PROMO_DOCUMENT_MEMORY_MB=512
# No PromoEditor daily cap by default (0 = unlimited). OpenAI still charges.
# Optionally set a positive integer for a daily ceiling, or "disabled" to block.
# These variables do NOT limit billing; set alerts/budgets with OpenAI directly.
PROMO_AI_IMAGE_CALLS_PER_DAY=0
PROMO_AI_TEXT_CALLS_PER_DAY=0
