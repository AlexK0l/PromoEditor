# Copy to deploy/caddy.env on the VPS; chmod 600.
# Provide a DNS A/AAAA record pointing to the VPS before launching Caddy.
PROMO_DOMAIN=promo.example.com
PROMO_AUTH_USER=promoeditor
# The hash MUST be generated on the VPS with: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Keep single quotes around the bcrypt hash so Compose does not interpolate its $ signs.
PROMO_AUTH_HASH='REPLACE_WITH_YOUR_BCRYPT_HASH'
