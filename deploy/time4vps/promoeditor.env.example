# Server-only: install to /etc/promoeditor/promoeditor.env with root:root 0600.
# Never commit a real API key, and do not send one in a chat.
OPENAI_API_KEY=
PROMO_REQUESTS_PER_HOUR=10
PROMO_JOB_TTL_SECONDS=7200
OPENAI_TEXT_MODEL=gpt-5.6-terra

# Generated ONLY on your VPS by provision_auth.py / switch_to_password_login.sh.
PROMO_AUTH_ENABLED=0
PROMO_PASSWORD_HASH=
PROMO_SESSION_SECRET=
