# API key is NEVER stored in browser code. Copy .env.example to .env on your own server.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
# OpenAI model used to design 3 AI-first compositions (requires JSON schema output)
OPENAI_LAYOUT_MODEL=gpt-4.1-mini
PROMO_REQUESTS_PER_HOUR=20
PROMO_JOB_TTL_SECONDS=7200
# Persistent OpenAI API quotas (UTC day; 0 disables the corresponding paid API).
# These are call ceilings, NOT monetary billing limits.
PROMO_AI_IMAGE_CALLS_PER_DAY=24
PROMO_AI_TEXT_CALLS_PER_DAY=80
# Optional: path to the local results directory
# PROMO_DATA_DIR=./instance/jobs

# Server-only auth settings for your private VPS; run provision_auth.py to generate.
PROMO_AUTH_ENABLED=0
# PROMO_PASSWORD_HASH=
# PROMO_SESSION_SECRET=
